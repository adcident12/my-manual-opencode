// Template of the global OpenCode config this manual ends up with.
// Copy to ~/.config/opencode/opencode.jsonc and replace every <placeholder>:
//   <user>          your OS user name (Windows paths below; on macOS/Linux use /Users/<user> or /home/<user>)
//   <your-server>   your model server's URL          <your-model-id>  the model id it reports at /v1/models
// Secrets never go in this file — only {env:NAME} references. Set the variables in your OS, then reopen the terminal.
// Details per block: setup.md, mcp-servers.md, plugins.md, tuning.md.
// Written for OpenCode 2 (tested on 2.0.26–2.0.28) in the V1 config syntax, which OpenCode 2 still reads.
// Inside one "mcp" entry, provider, agent or command, keep a single syntax (tuning.md section 9).
{
  "$schema": "https://opencode.ai/config.json",
  "model": "home-llamacpp/<your-model-id>",
  // tuning.md 9–10 — OpenCode 2 has no "prune"; it keeps a token budget of recent conversation beside
  // the compaction summary (default 15000). 24000 was measured for a night and did not cut re-reads, so keep the default.
  // buffer = tokens kept free below the context limit (default 10%). Set it to the model's output limit so prompt +
  // a full reply always fit in the server's context (llama.cpp ctx-size). Compaction then starts near 98k of 131k.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 15000 },
    "buffer": 32768
  },

  // OpenCode 2 also advertises ~/.claude/skills and ~/.agents/skills, and ignores OPENCODE_DISABLE_EXTERNAL_SKILLS.
  // Allow only this setup's skills (last matching rule wins). A new skill must be added here to be usable.
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "opencode", "effect": "allow" },
    { "action": "skill", "resource": "report", "effect": "allow" },
    { "action": "skill", "resource": "brainstorming", "effect": "allow" },
    { "action": "skill", "resource": "diagnosing-superpowers", "effect": "allow" },
    { "action": "skill", "resource": "dispatching-parallel-agents", "effect": "allow" },
    { "action": "skill", "resource": "executing-plans", "effect": "allow" },
    { "action": "skill", "resource": "finishing-a-development-branch", "effect": "allow" },
    { "action": "skill", "resource": "receiving-code-review", "effect": "allow" },
    { "action": "skill", "resource": "requesting-code-review", "effect": "allow" },
    { "action": "skill", "resource": "subagent-driven-development", "effect": "allow" },
    { "action": "skill", "resource": "systematic-debugging", "effect": "allow" },
    { "action": "skill", "resource": "test-driven-development", "effect": "allow" },
    { "action": "skill", "resource": "using-git-worktrees", "effect": "allow" },
    { "action": "skill", "resource": "using-superpowers", "effect": "allow" },
    { "action": "skill", "resource": "verification-before-completion", "effect": "allow" },
    { "action": "skill", "resource": "writing-plans", "effect": "allow" },
    { "action": "skill", "resource": "writing-skills", "effect": "allow" },
    { "action": "skill", "resource": "ponytail*", "effect": "allow" },
    { "action": "skill", "resource": "caveman*", "effect": "allow" },
    { "action": "skill", "resource": "grill-me", "effect": "allow" },
    { "action": "skill", "resource": "grilling", "effect": "allow" },
    // tuning.md 10 — folders outside the project the agent reaches by itself. An unanswered ask stalls an unattended
    // run, and OpenCode 2 stops a session that waits 60 minutes (gotchas.md item 28). Windows paths use backslashes.
    { "action": "external_directory", "resource": "C:\\Users\\<user>\\AppData\\Local\\npm-cache\\_npx\\*", "effect": "allow" },
    { "action": "external_directory", "resource": "C:\\Users\\<user>\\AppData\\Local\\Temp\\*", "effect": "allow" },
    { "action": "external_directory", "resource": "C:\\Users\\<user>\\.cache\\opencode\\packages\\*", "effect": "allow" }
  ],

  // Packages only. Local plugins need no entry: OpenCode 2 loads every .js file in ~/.config/opencode/plugin/
  // by itself — graft-deep.js, execute-guard.js, compaction-keep.js (config/plugin/) and caveman.js (the shim made by scripts/port-caveman-opencode2.mjs).
  // A local path listed here must be a directory; a file path is rejected (gotchas.md item 21).
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail"
  ],

  "provider": {
    // setup.md Part 2. output 32768: gotchas.md item 8.
    "home-llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Home llama.cpp",
      "options": {
        "baseURL": "https://<your-server>/v1",
        "apiKey": "{env:HOME_LLAMACPP_API_KEY}"
      },
      "models": {
        "<your-model-id>": {
          "name": "<any display name>",
          "limit": { "context": 131072, "output": 32768 }
        }
      }
    }
  },

  "mcp": {
    // OpenCode 2 starts every server once per loaded folder, all at once after a restart; slow starters
    // (sonarqube in Docker, trivy) miss the default 30 s (gotchas.md item 27).
    "timeout": { "startup": 90000 },

    // API key is optional (rate limits); delete "headers" if you have none.
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" },
      "enabled": true
    },

    // Off by default: ~6.6k tokens every turn, only needed when pulling work in from OpenDesign.
    // Enable per project by copying this whole entry into <project>/opencode.json with "enabled": true —
    // OpenCode 2 ignores a short { "enabled": true } override (gotchas.md item 22).
    // Windows: if `od` resolves to Git's od.exe (gotchas.md item 16), use
    //   "command": ["node", "C:/Users/<user>/.config/opencode/scripts/od.mjs", "mcp"]
    "open-design": {
      "type": "local",
      "command": ["od", "mcp"],
      "timeout": 30000,
      "enabled": false
    },

    // Off by default: same job as chrome-devtools, ~4.5k tokens every turn. e2e suites still run via `npx playwright test`.
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "timeout": 30000,
      "enabled": false
    },

    // tuning.md 10 — real debugger served by the VS Code extension ozzafar.debugmcpextension (mcp-servers.md).
    // Needs VS Code open on the project. Off by default; enable per project with this whole entry and "enabled": true.
    "debugmcp": {
      "type": "remote",
      "url": "http://localhost:3001/mcp",
      "enabled": false
    },

    // --isolated: temp profile per launch, never collides with another tool's chrome-devtools-mcp (gotchas.md item 17).
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-usage-statistics", "--isolated"],
      "timeout": 30000,
      "enabled": true
    },

    // Needs `graft build` + `graft init --agents agents --no-global` once per project.
    "graft": {
      "type": "local",
      "command": ["npx", "-y", "@nanonets/graft", "mcp"],
      "timeout": 30000,
      "enabled": true
    },

    // Only gets used because of the "Memory" rule in the global AGENTS.md (gotchas.md item 14).
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "environment": {
        "MEMORY_FILE_PATH": "C:/Users/<user>/.config/opencode/memory.jsonl"
      },
      "timeout": 30000,
      "enabled": true
    },

    // Needs Docker + a running SonarQube server + a *User* token in SONARQUBE_TOKEN. Use the host port your container publishes.
    // On macOS/Linux the command is just "docker".
    "sonarqube": {
      "type": "local",
      "command": [
        "C:/Program Files/Docker/Docker/resources/bin/docker.exe",
        "run", "--init", "--rm", "-i",
        "-e", "SONARQUBE_TOKEN",
        "-e", "SONARQUBE_URL",
        "sonarsource/sonarqube-mcp"
      ],
      "environment": {
        "SONARQUBE_TOKEN": "{env:SONARQUBE_TOKEN}",
        "SONARQUBE_URL": "http://host.docker.internal:9001"
      },
      "timeout": 30000,
      // Off by default (0 calls in 26 sessions); enable per project when it is analysed in SonarQube.
      "enabled": false
    },

    // If `trivy` is not on OpenCode's PATH, put the full path to trivy(.exe) here.
    "trivy": {
      "type": "local",
      "command": ["trivy", "mcp"],
      "timeout": 30000,
      // Off by default: the agent runs `trivy fs` through the shell (AGENTS.md), so the MCP tools only cost tokens.
      "enabled": false
    },

    // Disabled until a PAT exists in GITHUB_PERSONAL_ACCESS_TOKEN.
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": { "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}" },
      "enabled": false
    },

    // Databases: disabled globally, enabled per project with a full entry (setup.md Part 5, gotchas.md item 22).
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "{env:POSTGRES_CONNECTION_STRING}"],
      "timeout": 30000,
      "enabled": false
    },
    "mysql": {
      "type": "local",
      "command": ["npx", "-y", "@benborla29/mcp-server-mysql"],
      "environment": {
        "MYSQL_HOST": "{env:MYSQL_HOST}",
        "MYSQL_PORT": "{env:MYSQL_PORT}",
        "MYSQL_USER": "{env:MYSQL_USER}",
        "MYSQL_PASS": "{env:MYSQL_PASS}",
        "MYSQL_DB": "{env:MYSQL_DB}"
      },
      "timeout": 30000,
      "enabled": false
    }
  }
}
